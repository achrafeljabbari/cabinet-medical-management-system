APP_NAME=MediCare
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://votre-app.railway.app

# Railway provides DATABASE_URL, Laravel can use it via DB_URL
# DB_URL=

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicare
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

LOG_CHANNEL=stack
LOG_LEVEL=error

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# Assets
VITE_APP_NAME="${APP_NAME}"
